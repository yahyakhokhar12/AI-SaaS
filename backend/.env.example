HF_HOME=D:\AIModels\hf
HUGGINGFACE_HUB_CACHE=D:\AIModels\hf\hub
TORCH_HOME=D:\AIModels\torch

DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_saas

JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-4o-mini
OPENAI_COMPAT_TIMEOUT_SECONDS=90

LLM_PROVIDER=ollama
LLM_SYSTEM_PROMPT=You are a reliable multi-agent AI assistant. Be concise, factual, and privacy-preserving. Never fabricate capabilities, analysis results, file metadata, image details, resolution, or technical specs. If required input is missing, explicitly say what is missing and ask for it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_VISION_MODEL=moondream
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_BATCH=32
OLLAMA_MIN_BATCH=16
OLLAMA_TEXT_FALLBACK_MODEL=llama3.2:1b
OLLAMA_VISION_FALLBACK_MODEL=
STREAM_RETRY_ATTEMPTS=3
STREAM_RETRY_BACKOFF_SECONDS=0.8
EMBEDDINGS_PROVIDER=sentence_transformers
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

SD_MODEL_ID=segmind/tiny-sd
SD_FALLBACK_MODEL_ID=runwayml/stable-diffusion-v1-5
SD_NUM_INFERENCE_STEPS=20
SD_GUIDANCE_SCALE=7.0
SD_WIDTH=512
SD_HEIGHT=512
SD_REALISM_BOOST=true
SD_NEGATIVE_PROMPT=blurry, low quality, noisy, distorted, artifacts, watermark, text, cartoon, painting, cgi, 3d render

REDIS_URL=redis://localhost:6379/0
FREE_DAILY_LIMIT=40
PRO_DAILY_LIMIT=400

PAYMENT_RETURN_URL=http://localhost:5173/billing
ENABLE_PAYMENT_SIMULATION=false
PAYMENT_SIMULATION_TOKEN=change-me-dev-only

EASYPAISA_MERCHANT_ID=your-easypaisa-merchant-id
EASYPAISA_SECRET=your-easypaisa-secret
EASYPAISA_GATEWAY_URL=https://easypaisa.example/pay

JAZZCASH_MERCHANT_ID=your-jazzcash-merchant-id
JAZZCASH_SECRET=your-jazzcash-secret
JAZZCASH_GATEWAY_URL=https://jazzcash.example/pay

CARD_GATEWAY_MERCHANT_ID=your-card-gateway-merchant-id
CARD_GATEWAY_SECRET=your-card-gateway-secret
CARD_GATEWAY_URL=https://card-gateway.example/pay

PBI_ENABLE_UPLOAD=false
PBI_BASE_URL=https://api.powerbi.com/v1.0/myorg
PBI_WORKSPACE_ID=
PBI_ACCESS_TOKEN=
PBI_TEMPLATE_REPORT_ID=
PBI_EXPORT_FORMAT=PDF
PBI_EXPORT_TIMEOUT_SECONDS=120
